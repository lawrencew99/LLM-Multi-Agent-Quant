# ─── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── LangSmith (optional, for trace visualization) ────────────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=newsalpha

# ─── Data APIs ────────────────────────────────────────────────────────────────
FINNHUB_API_KEY=...
ALPACA_API_KEY=...
ALPACA_SECRET_KEY=...
FRED_API_KEY=...                # https://fred.stlouisfed.org/docs/api/api_key.html

# ─── Databases ────────────────────────────────────────────────────────────────
POSTGRES_DSN=postgresql+psycopg://newsalpha:newsalpha_dev@localhost:5432/newsalpha
QDRANT_URL=http://localhost:6333
REDIS_URL=redis://localhost:6379/0

# ─── Broker ───────────────────────────────────────────────────────────────────
BROKER_MODE=paper               # paper | live  (live requires explicit confirmation)
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ─── LLM Budget (safeguard) ───────────────────────────────────────────────────
LLM_DAILY_BUDGET_USD=20.0       # pause LLM calls when daily spend exceeds this

# ─── App ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
ENVIRONMENT=development          # development | production
